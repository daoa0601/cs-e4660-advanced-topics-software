# =============================================================================
# Google Cloud Configuration
# =============================================================================

# Required: Your GCP project ID
GCP_PROJECT_ID=your-project-id

# GCP region for Vertex AI (default: us-central1)
# Options: us-central1, us-east1, us-west1, europe-west1, asia-northeast1, etc.
GCP_REGION=us-central1

# Path to service account key (optional if using gcloud auth / ADC)
# If using ADC, run: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# Experiment Settings
# =============================================================================

# Number of iterations per variant (default: 20)
DEFAULT_ITERATIONS=20

# Delay between sequential API calls in seconds (default: 0.5)
# Ignored when running in parallel mode
DELAY_BETWEEN_CALLS=0.5

# =============================================================================
# Database Configuration
# =============================================================================

# Path to SQLite database file (default: data/experiments.db)
DB_PATH=data/experiments.db

# =============================================================================
# Logging & Verbosity (Optional)
# =============================================================================

# Suppress gRPC debug messages (set to ERROR to reduce noise)
# Options: DEBUG, INFO, WARNING, ERROR
GRPC_VERBOSITY=ERROR

# Suppress TensorFlow C++ warnings (2 = ERROR only, 3 = FATAL only)
TF_CPP_MIN_LOG_LEVEL=2

# Suppress Google Auth library info messages
GOOGLE_AUTH_LIBRARY_LOGGING=ERROR
